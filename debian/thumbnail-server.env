### Seafile thumbnail server configuration ###
# Loaded as environment variables by seaf-thumbnail-server.service, after
# seafile.env: database, cache and JWT_PRIVATE_KEY come from there.
# The server listens on 127.0.0.1:8088. To use it, set ENABLE_THUMBNAIL_SERVER = True
# in seahub_settings.py and route /thumbnail/ to it in the reverse proxy (see the
# commented routes in the seafile-server examples).
# Reference: https://manual.seafile.com/14.0/extension/thumbnail-server/

# Worker threads per file type queue.
#THUMBNAIL_TASK_WORKERS=3
# Size limits in MB: image file, decoded image in memory, PDF file.
#THUMBNAIL_IMAGE_SIZE_LIMIT=30
#THUMBNAIL_IMAGE_ORIGINAL_SIZE_LIMIT=256
#THUMBNAIL_PDF_SIZE_LIMIT=50
# The server exits to be restarted once its memory use exceeds this, in MB.
#THUMBNAIL_MEMORY_LIMIT=4096
# URL the permission checks go to.
#INNER_SEAHUB_SERVICE_URL=http://127.0.0.1:8000
